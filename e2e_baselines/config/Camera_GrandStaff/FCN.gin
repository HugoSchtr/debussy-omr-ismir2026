main.train_path = "Data/grandstaff_dataset/partitions/train.txt"
main.val_path = "Data/grandstaff_dataset/partitions/val.txt"
main.test_path = "Data/grandstaff_dataset/partitions/test.txt"
main.encoding = "bekrn"
main.model_name = "FCN"

load_data.extension = ".bekrn"
load_data.load_distorted = True
load_data.resize_ratio = 0.75  # Balance: reduce OOM while avoiding CTC violations (0.5 causes NaN)