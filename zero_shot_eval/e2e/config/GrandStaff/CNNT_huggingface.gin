# Configuration for training with HuggingFace PRAIG/grandstaff dataset
# This uses the official splits from HuggingFace

# Use HuggingFace dataset instead of local files
main.use_huggingface = True
main.encoding = "bekrn"
main.model_name = "CNNT"
main.dataset_name = "PRAIG/grandstaff"
main.random_seed = 42  # For reproducibility

# HuggingFace dataset configuration
load_dataset_from_huggingface.dataset_name = "PRAIG/grandstaff"
load_dataset_from_huggingface.corpus_name = "GrandStaff_bekrn"
load_dataset_from_huggingface.resize_ratio = 1.0  # Full size - DO NOT REDUCE or CTC will fail
